{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev · Chrome (mock CDN)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "preLaunchTask": "Mock CDN",
      "args": [
        "--dart-define-from-file=env/dev.json"
      ],
      "codeLens": {
        "for": [
          "run-file",
          "debug-file"
        ],
        "path": "lib/main.dart",
        "title": "${debugType} · Chrome"
      }
    },
    {
      "name": "Dev · iOS simulator (mock CDN)",
