{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web · Chrome",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--dart-define-from-file=env/web.json"
      ],
      "codeLens": {
        "for": [
          "run-file",
          "debug-file"
        ],
        "path": "lib/main.dart",
        "title": "${debugType} · Web"
      }
    },
    {
      "name": "iOS · simulator or iPhone",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define-from-file=env/ios.json"
      ],
      "codeLens": {
        "for": [
          "run-file",
          "debug-file"
        ],
        "path": "lib/main.dart",
        "title": "${debugType} · iOS"
      }
    },
    {
      "name": "Android · emulator or phone",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define-from-file=env/android.json"
      ],
      "codeLens": {
        "for": [
          "run-file",
          "debug-file"
        ],
        "path": "lib/main.dart",
        "title": "${debugType} · Android"
      }
    }
  ]
}
