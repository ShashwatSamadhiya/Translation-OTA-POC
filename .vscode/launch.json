{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev · Chrome",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--dart-define-from-file=env/dev.json"
      ],
      "codeLens": {
        "for": [
          "run-file",
          "debug-file"
        ],
        "path": "lib/main.dart",
        "title": "${debugType} · Chrome"
      }
    },
    {
      "name": "Dev · device",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define-from-file=env/dev.json"
      ],
      "codeLens": {
        "for": [
          "run-file",
          "debug-file"
        ],
        "path": "lib/main.dart",
        "title": "${debugType} · device"
      }
    }
  ]
}
